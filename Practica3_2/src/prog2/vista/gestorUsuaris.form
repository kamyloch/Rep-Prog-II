<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="prog2.vista.gestorUsuaris">
  <grid id="27dc6" binding="PanelUsuaris" custom-create="true" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="1bac" binding="PanelBotons" custom-create="true" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c5750" class="javax.swing.JButton" binding="botoMostra" custom-create="true">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <icon value="prog2/vista/imatges/user_list.png"/>
              <text value="Visualitzar-ne."/>
            </properties>
          </component>
          <component id="812f5" class="javax.swing.JButton" binding="botoAfegir" custom-create="true">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <icon value="prog2/vista/imatges/add_user.png"/>
              <text value="Afegir-ne"/>
            </properties>
          </component>
          <component id="fd442" class="javax.swing.JButton" binding="botoTornar" custom-create="true">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <icon value="prog2/vista/imatges/back.png"/>
              <text value="Tornar"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="acea6" binding="PanelLlista">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c4288" class="javax.swing.JList" binding="llista" custom-create="true">
            <constraints/>
            <properties>
              <model/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
